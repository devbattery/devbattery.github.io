{% assign navigation = site.data.navigation[include.nav] %}
{% assign sum = site.posts | size %}
{% assign all_posts_url = site.category_archive.path | default: "/categories/" %}

<nav class="nav__list nav__list--categories db-nav-list">
  <div class="db-nav-list__header">
    <p class="db-nav-list__eyebrow">Browse</p>
    <h3 class="nav__title nav__title--sidebar">{{ page.sidebar.title | default: "Categories" }}</h3>
  </div>
  <a
    href="{{ all_posts_url | relative_url }}"
    class="nav__all-posts-link db-nav-list__all-posts-link{% if page.url == all_posts_url %} is-active{% endif %}"
  >
    <span class="nav__all-posts-title">All Posts</span>
    <span class="nav__all-posts-count">{{ sum }}</span>
  </a>

  <ul class="nav__items nav__items--category-groups">
    {% for nav in navigation %}
      <li class="nav__group db-nav-list__group">
        <span class="nav__sub-title nav__sub-title--group">{{ nav.title }}</span>
        {% if nav.children != null %}
        <ul class="nav__group-links">
          {% for child in nav.children %}
          
          {% comment %}
          {% endcomment %}
          {% assign post_cnt = 0 %}
          {% for category in site.categories %}
            {% if category[0] == child.category  %}
                {% assign post_cnt = category[1].size %}
            {% endif %}
          {% endfor %}

            <li>
              <a href="{{ child.url | relative_url }}"{% if child.url == page.url %} class="nav__child-link active"{% else %} class="nav__child-link"{% endif %}>
                <span class="nav__child-title">{{ child.title }}</span>
                <span class="nav__child-count">{{ post_cnt }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
